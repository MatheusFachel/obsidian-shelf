{
	"name": "obsidian-shelf",
	"version": "0.1.0",
	"description": "Lightweight sidebar view with custom folder groupings ('shelves') for organizing your vault by context.",
	"author": "Matheus Fachel",
	"repository": {
		"type": "git",
		"url": "https://github.com/MatheusFachel/obsidian-shelf.git"
	},
	"bugs": "https://github.com/MatheusFachel/obsidian-shelf/issues",
	"homepage": "https://github.com/MatheusFachel/obsidian-shelf",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": ["obsidian", "obsidian-plugin", "shelf", "file-explorer", "gallery"],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "20.19.43",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"obsidian": "1.14.4"
	}
}
